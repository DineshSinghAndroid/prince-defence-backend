# Environment & Port
NODE_ENV=production
PORT=5000

# Database: SQLite is self-contained in data/database.sqlite (Zero external DB server needed)
# MONGODB_URI is optional/no longer required.

# Security & JWT Token
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated)
FRONTEND_ORIGINS=https://princedefence.com,https://www.princedefence.com,https://admin.princedefence.com

# CSRF Trusted Origins (Comma-separated)
CSRF_TRUSTED_ORIGINS=https://admin.princedefence.com,https://princedefence.com,https://www.princedefence.com

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Resend Email Service
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@princedefence.com

# Super Admin Seed
ADMIN_PASSWORD=your_superadmin_seed_password
